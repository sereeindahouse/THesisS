{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NMCT source-linked content draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "facts",
    "faqs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "faqs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faq"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "locator"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "title",
        "source_url_or_filename",
        "retrieved_at",
        "source_updated_at",
        "scope",
        "content_capture",
        "notes",
        "approval_status",
        "approved_by",
        "approved_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url_or_filename": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "source_updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "content_capture": {
          "enum": [
            "selected_fact_extract",
            "audit_metadata_only",
            "full_snapshot"
          ]
        },
        "notes": {
          "type": "string"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_status": {
                "const": "approved"
              }
            },
            "required": [
              "approval_status"
            ]
          },
          "then": {
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "entity_id",
        "key",
        "value",
        "source_refs",
        "scope",
        "notes",
        "approval_status",
        "approved_by",
        "approved_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_status": {
                "const": "approved"
              }
            },
            "required": [
              "approval_status"
            ]
          },
          "then": {
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faq_id",
        "question",
        "answer",
        "question_aliases",
        "fact_ids",
        "source_refs",
        "scope",
        "answer_status",
        "notes",
        "approval_status",
        "approved_by",
        "approved_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "faq_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "question_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "answer_status": {
          "enum": [
            "complete_in_scope",
            "partial_in_scope"
          ]
        },
        "notes": {
          "type": "string"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_status": {
                "const": "approved"
              }
            },
            "required": [
              "approval_status"
            ]
          },
          "then": {
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
